# Copia este archivo a .env y llena los valores. Todo lo que empieza con VITE_ se
# incluye en el bundle del frontend (nunca pongas aquí una API key secreta — esas
# viven solo en el Worker, ver /worker/wrangler.toml y /README.md).

# URL pública de tu Cloudflare Worker (después de "wrangler deploy").
VITE_WORKER_URL=https://companion-worker.TU-SUBDOMINIO.workers.dev

# agent_id del agente de ElevenLabs (Conversational AI). Ya trae un default hardcodeado en
# AppContext.jsx (el agente Maite real) — solo llena esto si se recrea el agente y cambia el id.
VITE_ELEVENLABS_AGENT_ID=

# Vía 2 (fallback) de fecha/hora para el widget — déjalo vacío/false por defecto. La Vía 1
# ({{system__time}} configurado en ElevenLabs con timezone Europe/Madrid) no requiere esta
# variable. Solo pon "true" aquí si en pruebas reales el LLM falla la aritmética de husos.
VITE_AGENTE_VIA2_HORA=false

# Clave pública VAPID para Web Push (la generas una vez, ver README "Notificaciones push").
VITE_VAPID_PUBLIC_KEY=

# Número de WhatsApp del contacto SOS principal, formato internacional sin "+" ni espacios.
VITE_SOS_WHATSAPP_NUMERO=

# Teléfono del Consulado de México más cercano a Pamplona (formato para tel:).
VITE_SOS_CONSULADO_TEL=

# Dirección de su residencia (CampusHome), para mostrarla en el modo emergencia. Por defecto
# ya trae "CampusHome — Av. de Pío XII, 28, Iturrama, Pamplona" (confirmado en KB3) — solo
# llena esto si cambia de residencia.
VITE_RESIDENCIA_DIRECCION=

# Coordenadas de CampusHome para el pin del mapa. Ya traen un valor aproximado por default
# (ver app/src/data/pines.js) — verifica en Google Maps y ajusta aquí si no cae exacto.
VITE_RESIDENCIA_LAT=
VITE_RESIDENCIA_LNG=

# mid del Google My Maps del mapa interior de la Escuela de Arquitectura (Mapa → Mapa interior).
# Ya trae un default hardcodeado en PlanoEdificio.jsx — solo llena esto si rehaces el mapa desde
# cero y te da un mid distinto. Se saca de la URL al abrir tu mapa en Google My Maps:
# .../viewer?mid=AQUI_ESTA
VITE_MAPA_INTERIOR_MID=
